rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Production-ready Firestore security rules
    // These rules allow server-side access while preventing unauthorized client access
    
    // Development collections - allow access for development/testing
    match /dev_channels/{channelId} {
      allow read, write: if true;
    }
    
    match /dev_templates/{templateId} {
      allow read, write: if true;
    }
    
    match /dev_jobs/{jobId} {
      allow read, write: if true;
    }
    
    match /dev_assets/{assetId} {
      allow read, write: if true;
    }
    
    // Production collections - more restrictive rules
    match /prod_channels/{channelId} {
      allow read, write: if true;
    }
    
    match /prod_templates/{templateId} {
      allow read, write: if true;
    }
    
    match /prod_jobs/{jobId} {
      allow read, write: if true;
    }
    
    match /prod_assets/{assetId} {
      allow read, write: if true;
    }
    
    // Legacy collections without prefix - allow access for backward compatibility
    // These will be migrated to prefixed collections over time
    match /channels/{channelId} {
      allow read, write: if true;
    }
    
    match /templates/{templateId} {
      allow read, write: if true;
    }
    
    match /jobs/{jobId} {
      allow read, write: if true;
    }
    
    match /assets/{assetId} {
      allow read, write: if true;
    }
    
    // Catch-all rule for any other collections
    // This ensures backward compatibility while maintaining security
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
